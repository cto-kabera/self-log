# Local Docker (default for day-to-day work)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:43125
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Cloud (Render + hosted Supabase). Leave local values above for Docker.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-cloud-publishable-or-anon-key
# NEXT_PUBLIC_SITE_URL=https://YOUR_SERVICE.onrender.com
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
